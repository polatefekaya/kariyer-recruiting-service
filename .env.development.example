# GitHub Packages credentials for Kariyer.Messaging.Contracts (build time)
GITHUB_USER=
GITHUB_TOKEN=

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=5340

ConnectionStrings__Postgres=Host=127.0.0.1;Port=5432;Database=kariyerzamani_test;Username=postgres;Password=
ConnectionStrings__RabbitMQ=amqp://guest:guest@127.0.0.1:5672

Auth__ExternalProviderUrl=https://<project>.supabase.co
Auth__Audience=authenticated

Persistence__MigrateOnStartup=true

Garnet__ConnectionString=127.0.0.1:6379
Garnet__Enabled=true

RateLimiting__Enabled=true
RateLimiting__WritesPerMinute=60
RateLimiting__ConfirmationsPerMinute=10

Messaging__Enabled=true
OpenTelemetry__Endpoint=http://127.0.0.1:4317
Recruiting__PublicSiteUrl=https://tst.kariyerzamani.com
Recruiting__PublicApiUrl=https://tst.kariyerzamani.com/api/recruiting
Recruiting__ConfirmationSigningKey=replace-with-a-secure-key-at-least-32-chars
Recruiting__AllowedOrigins__0=https://tst.kariyerzamani.com
Recruiting__AllowedOrigins__1=http://localhost:5199
