# GitHub Packages credentials for Kariyer.Messaging.Contracts (build time).
GITHUB_USER=
GITHUB_TOKEN=

ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=kariyer;Username=kariyer;Password=
ConnectionStrings__RabbitMQ=amqp://user:pass@rabbitmq:5672

Auth__ExternalProviderUrl=https://<project>.supabase.co
Auth__Audience=authenticated

Persistence__MigrateOnStartup=false

# Garnet speaks RESP; same instance the SEO service purges prerendered pages from.
Garnet__ConnectionString=garnet:6379
Garnet__Enabled=true

# Rate limits on the mutating routes. Partitioned by the token's subject (not the IP — behind the
# gateway every request comes from 127.0.0.1) and, for the candidate's anonymous accept/decline
# routes, by the interview uid being answered.
RateLimiting__Enabled=true
RateLimiting__WritesPerMinute=60
RateLimiting__ConfirmationsPerMinute=10

Messaging__Enabled=true
OpenTelemetry__Endpoint=http://otel-collector:4317
Recruiting__PublicSiteUrl=https://kariyerzamani.com
# Where the candidate's accept/decline links resolve — this service's own public base URL.
Recruiting__PublicApiUrl=https://api.kariyerzamani.com/api/recruiting
# Signs those links; required outside Development. Rotating it invalidates unanswered invitations.
Recruiting__ConfirmationSigningKey=
# The employer portal's origin(s). Comma-separated. Without this the browser blocks every
# request from it before the service ever sees one.
Recruiting__AllowedOrigins__0=https://basvuru.kariyerzamani.com
