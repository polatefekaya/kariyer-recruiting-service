# GitHub Packages credentials for Kariyer.Messaging.Contracts (build time)
GITHUB_USER=
GITHUB_TOKEN=

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=5340

ConnectionStrings__Postgres=Host=host.docker.internal;Port=5432;Database=kariyer;Username=postgres;Password=
ConnectionStrings__RabbitMQ=amqp://user:pass@host.docker.internal:5672

Auth__ExternalProviderUrl=https://<project>.supabase.co
Auth__Audience=authenticated

Persistence__MigrateOnStartup=false

Garnet__ConnectionString=host.docker.internal:6379
Garnet__Enabled=true

RateLimiting__Enabled=true
RateLimiting__WritesPerMinute=60
RateLimiting__ConfirmationsPerMinute=10

Messaging__Enabled=true
OpenTelemetry__Endpoint=http://host.docker.internal:4317
Recruiting__PublicSiteUrl=https://kariyerzamani.com
Recruiting__EmployerPortalUrl=https://basvurular.kariyerzamani.com
Recruiting__PublicApiUrl=https://api.kariyerzamani.com/api/recruiting
Recruiting__ConfirmationSigningKey=replace-with-production-signing-key-32-chars
Recruiting__AllowedOrigins__0=https://basvurular.kariyerzamani.com
Recruiting__AllowedOrigins__1=https://kariyerzamani.com
