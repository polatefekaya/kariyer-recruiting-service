<Project Sdk="Microsoft.NET.Sdk">

  <!-- Web SDK types (IResult) are referenced by the handler signatures under test. These tests
       call handlers directly against a real Postgres rather than over HTTP, so there is no host
       to spin up and Microsoft.AspNetCore.Mvc.Testing is not referenced. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kariyer.Recruiting.Api\Kariyer.Recruiting.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\deploy\smoke\public_standins.sql" Link="public_standins.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
